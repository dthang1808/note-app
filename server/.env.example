MONGODB_URI=mongodb://127.0.0.1:27017/note_app
MONGODB_DB_NAME=note_app
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
CLIENT_URL=http://localhost:5173
# Optional: create this first account and assign notes from the previous app version to it.
INITIAL_USER_USERNAME=your_username
INITIAL_USER_PASSWORD=use-a-unique-password-at-least-12-characters
# Optional: comma-separated DNS server IPs if Node.js cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
